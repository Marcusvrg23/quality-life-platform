# Copy this file to .env for local development and replace every placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=quality_life
POSTGRES_USER=quality_life
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_SSLMODE=prefer
